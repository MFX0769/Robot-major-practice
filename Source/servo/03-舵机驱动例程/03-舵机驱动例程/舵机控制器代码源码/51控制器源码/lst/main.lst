 264          void parse_psx_buf(unsigned char *buf, unsigned char mode) {
 265   1        u8 i, pos = 0;
 266   1        static u16 bak=0xffff, temp, temp2;
 267   1        temp = (buf[0]<<8) + buf[1];
 268   1        
 269   1        if(bak != temp) {
 270   2          temp2 = temp;
 271   2          temp &= bak;
 272   2          for(i=0;i<16;i++) {
 273   3            if((1<<i) & temp) {
 274   4            } else {
 275   4              if((1<<i) & bak) {  //press
 276   5                                    
 277   5                memset(uart_receive_buf, 0, sizeof(uart_receive_buf));          
 278   5                if(mode == PS2_LED_RED) {
 279   6                  memcpy((char *)uart_receive_buf, (char *)pre_cmd_set_red[i], strlen(pre_cmd_set_red[i]));
 280   6                } else if(mode == PS2_LED_GRN) {
 281   6                  memcpy((char *)uart_receive_buf, (char *)pre_cmd_set_GRNe[i], strlen(pre_cmd_set_GRNe[i]));
 282   6                } else continue;
 283   5                
 284   5                pos = str_contain_str(uart_receive_buf, "^");
 285   5                if(pos) uart_receive_buf[pos-1] = '\0';
 286   5                if(str_contain_str(uart_receive_buf, "$")) {
 287   6                  //uart1_close();
 288   6                  uart1_get_ok = 1;
 289   6                  uart1_mode = 1;
 290   6                  strcpy(cmd_return, uart_receive_buf+11);
 291   6                  strcpy(uart_receive_buf, cmd_return);
 292   6                } else if(str_contain_str(uart_receive_buf, "#")) {
 293   6                  //uart1_close();
 294   6                  uart1_get_ok = 1;
 295   6                  uart1_mode = 2;
 296   6                  strcpy(cmd_return, uart_receive_buf+11);
 297   6                  strcpy(uart_receive_buf, cmd_return);
 298   6                }
 299   5                
 300   5                uart1_send_str(uart_receive_buf);
 301   5                
C51 COMPILER V9.00   MAIN                                                                  05/27/2021 09:57:36 PAGE 6   

 302   5                bak = 0xffff;
 303   5              } else {//release
 304   5                          
 305   5                memset(uart_receive_buf, 0, sizeof(uart_receive_buf));          
 306   5                if(mode == PS2_LED_RED) {
 307   6                  memcpy((char *)uart_receive_buf, (char *)pre_cmd_set_red[i], strlen(pre_cmd_set_red[i]));
 308   6                } else if(mode == PS2_LED_GRN) {
 309   6                  memcpy((char *)uart_receive_buf, (char *)pre_cmd_set_GRNe[i], strlen(pre_cmd_set_GRNe[i]));
 310   6                } else continue;  
 311   5                
 312   5                pos = str_contain_str(uart_receive_buf, "^");
 313   5                if(pos) {
 314   6                  if(str_contain_str(uart_receive_buf+pos, "$")) {
 315   7                    //uart1_close();
 316   7                    uart1_get_ok = 1;
 317   7                    uart1_mode = 1;
 318   7                    strcpy(cmd_return, uart_receive_buf+pos);
 319   7                    cmd_return[strlen(cmd_return) - 1] = '\0';
 320   7                    strcpy(uart_receive_buf, cmd_return);
 321   7                  } else if(str_contain_str(uart_receive_buf+pos, "#")) {
 322   7                    //uart1_close();
 323   7                    uart1_get_ok = 1;
 324   7                    uart1_mode = 2;
 325   7                    strcpy(cmd_return, uart_receive_buf+pos);
 326   7                    cmd_return[strlen(cmd_return) - 1] = '\0';
 327   7                    strcpy(uart_receive_buf, cmd_return);
 328   7                  }
 329   6                  uart1_send_str(uart_receive_buf);
 330   6                } 
 331   5              }
 332   4      
 333   4            }
 334   3          }
 335   2          bak = temp2;
 336   2          beep_on();mdelay(50);beep_off();
 337   2        } 
 338   1        return;
 339   1      }
